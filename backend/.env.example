# Environment variables example — copy to .env and fill in real values
AWS_REGION=us-east-1
AWS_TRUSTED_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_OAUTH_CLIENT_ID=
GCP_OAUTH_CLIENT_SECRET=
GCP_OAUTH_REDIRECT_URI=http://localhost:8000/api/gcp/callback
GCP_OAUTH_STATE_SECRET=
GCP_TOKEN_ENCRYPTION_KEY=
FRONTEND_BASE_URL=http://localhost:5173
SUPABASE_SERVICE_ROLE_KEY=
# Optional local-only fallback; not used by the customer OAuth flow.
GOOGLE_APPLICATION_CREDENTIALS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
